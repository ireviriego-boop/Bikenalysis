# Copia este fichero a ".env" y rellena con tus valores reales
# (los que ves en dashboard.hammerhead.io -> Ajustes -> Ajustes de la API)

HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:3001
HH_SCOPE=activity:read

# Strava: crea una app en strava.com/settings/api (Authorization Callback
# Domain = localhost) y copia aqui el "Client ID" y "Client Secret" que te da.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3002
